//                                                         ▀▀▀   █   ▀▀▀   █   ▀▀▀   ▀   ▀▀▀
//                                                               █      ▄▄▄█▄▄▄    █   █
//                                                               ▀      █  █  █     █▄█
//                                                             ▀▀▀▀▀    █  █  █      ▀
//                                                                      ▀  ▀  ▀
//
// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄
//
//   Layer 0: BASE    — QWERTY, dedicated thumb modifiers, outer pinky keys
//   Layer 1: SYMFN   — symbols, brackets, F1-F12 (hold Left Thumb 2)
//   Layer 2: NAVNUM  — navigation arrows, keypad numbers (hold Right Thumb 2)
//   Layer 3: MEDIA   — media, brightness, app launchers, BT profiles (dual-thumb combo 32+35)
//   Layer 4: MOUSE   — mouse movement, scroll, clicks (dual-thumb combo 33+34)

#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE   0
#define SYMFN  1
#define NAVNUM 2
#define MEDIA  3
#define MOUSE  4

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <280>;
    quick-tap-ms = <220>;
    require-prior-idle-ms = <150>;
};

&lt {
    flavor = "balanced";
    tapping-term-ms = <300>;
    quick-tap-ms = <220>;
};

/ {
    combos {
        compatible = "zmk,combos";

        // ── Tier 1: Essential ──────────────────────────────────────
        // ── Tier 2: High Value ─────────────────────────────────────

        combo_enter {
            bindings = <&kp RET>;
            key-positions = <17 18 16>;         // K + L
            timeout-ms = <70>;
            require-prior-idle-ms = <150>;
        };

        // ── Tier 3: Vertical Symbol Combos ─────────────────────────

        combo_equal {
            bindings = <&kp EQUAL>;
            key-positions = <28 29>;         // F + V (left index vertical)
            timeout-ms = <70>;
            require-prior-idle-ms = <150>;
        };

        media_layer {
            bindings = <&lt MEDIA RIGHT_ALT>;
            key-positions = <32 35>;
            timeout-ms = <70>;
            require-prior-idle-ms = <150>;
        };

        tilde {
            bindings = <&kp TILDE>;
            key-positions = <17 18>;
            timeout-ms = <70>;
            require-prior-idle-ms = <150>;
        };

        Tab {
            bindings = <&kp TAB>;
            key-positions = <0 1>;
            timeout-ms = <70>;
            require-prior-idle-ms = <150>;
        };

        minus_and_underscore {
            bindings = <&kp MINUS>;
            key-positions = <19 18>;
            timeout-ms = <70>;
            require-prior-idle-ms = <150>;
        };

        plus {
            bindings = <&kp PLUS>;
            key-positions = <8 9>;
            timeout-ms = <80>;
            require-prior-idle-ms = <170>;
        };

        quick_search {
            bindings = <&kp C_AC_SEARCH>;
            key-positions = <1 2 3>;
            timeout-ms = <70>;
            require-prior-idle-ms = <150>;
        };

        mouse_layer {
            bindings = <&lt MOUSE LEFT_ALT>;
            key-positions = <33 34>;
            timeout-ms = <70>;
            require-prior-idle-ms = <150>;
        };

        combo-enter-left {
            bindings = <&kp ENTER>;
            key-positions = <11 12 13>;
            timeout-ms = <70>;
            require-prior-idle-ms = <150>;
        };

        combo-backspace {
            bindings = <&kp BACKSPACE>;
            key-positions = <7 8>;
            timeout-ms = <80>;
            require-prior-idle-ms = <170>;
        };
    };

    macros {
        hyper: hyper {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LGUI &kp LALT &kp LCTRL &kp LSHFT>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LGUI &kp LALT &kp LCTRL &kp LSHFT>;
        };

        degree: degree {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LA(NUMBER_8))>;
            label = "DEGREE";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

        base_layer {
            display-name = "BASE";
            bindings = <
&kp Q          &kp W  &kp E                       &kp R          &kp T           &kp Y      &kp U               &kp I                &kp O    &kp P
&kp A          &kp S  &kp D                       &kp F          &kp G           &kp H      &kp J               &kp K                &kp L    &kp SEMI
&kp Z          &kp X  &kp C                       &kp V          &kp B           &kp N      &kp M               &kp COMMA            &kp DOT  &kp SLASH
&mt LCTRL ESC         &mt LEFT_COMMAND BACKSPACE  &lt SYMFN TAB  &kp LEFT_SHIFT  &kp SPACE  &lt NAVNUM LS(TAB)  &mt LEFT_ALT DELETE           &kp SINGLE_QUOTE
            >;
        };

        symfn_layer {
            bindings = <
&kp PIPE          &kp AT            &kp RA(QUESTION)      &kp DOLLAR      &kp PERCENT  &kp HASH       &kp AMPERSAND    &kp QUESTION           &kp BACKSPACE      &kp DELETE
&kp LA(NUMBER_1)  &kp LEFT_BRACKET  &kp LEFT_PARENTHESIS  &kp LEFT_BRACE  &kp SLASH    &kp BACKSLASH  &kp RIGHT_BRACE  &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACKET  &kp EXCLAMATION
&kp F2            &kp F3            &kp F4                &kp F5          &kp F6       &kp F7         &kp F8           &kp F9                 &kp F10            &kp F11
&kp F1                              &none                 &none           &none        &kp SPACE      &kp RIGHT_ALT    &kp RIGHT_COMMAND                         &kp F12
            >;

            label = "SYMFN";
        };

        navnum_layer {
            display-name = "NAVNUM";
            bindings = <
&kp TAB                  &kp HOME       &kp UP            &kp END       &kp K_REDO      &kp CARET     &kp NUMBER_7  &kp NUMBER_8    &kp NUMBER_9  &kp KP_PLUS
&kp CAPSLOCK             &kp LEFT       &kp DOWN          &kp RIGHT     &kp K_UNDO      &kp ASTERISK  &kp NUMBER_4  &kp NUMBER_5    &kp NUMBER_6  &kp KP_MINUS
&kp INS                  &kp PAGE_DOWN  &kp ENTER         &kp PG_UP     &kp ENTER       &kp NUMBER_0  &kp NUMBER_1  &kp NUMBER_2    &kp NUMBER_3  &kp EQUAL
&mt LEFT_CONTROL ESCAPE                 &kp LEFT_COMMAND  &kp LEFT_ALT  &kp LEFT_SHIFT  &none         &none         &kp KP_NUMLOCK                &hyper
            >;
        };

        media_layer {
            display-name = "MEDIA";
            bindings = <
&none                 &kp C_AL_INSTANT_MESSAGING  &kp C_AL_CALC         &kp C_AL_CALENDAR     &none  &kp C_STOP    &kp C_PREV    &kp C_PLAY_PAUSE   &kp C_NEXT       &none
&kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC        &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &none  &none         &kp C_MUTE    &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &none
&none                 &none                       &none                 &none                 &none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2       &bt BT_SEL 3     &none
&mt RCTRL ESCAPE                                  &none                 &none                 &none  &none         &none         &none                               &bt BT_CLR
            >;
        };

        mouse_layer {
            display-name = "MOUSE";
            bindings = <
&none              &msc SCRL_LEFT  &mmv MOVE_UP    &msc SCRL_RIGHT  &none             &none  &none      &mmv MOVE_Y(300)   &none      &none
&mmv MOVE_X(-300)  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &mmv MOVE_X(300)  &none  &mkp LCLK  &mmv MOVE_Y(-300)  &mkp RCLK  &none
&none              &msc SCRL_DOWN  &none           &msc SCRL_UP     &none             &none  &none      &mkp MCLK          &none      &none
&none                              &none           &none            &none             &none  &none      &none                         &none
            >;
        };
    };
};
