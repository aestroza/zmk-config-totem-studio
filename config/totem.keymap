//                                                         ▀▀▀   █   ▀▀▀   █   ▀▀▀   ▀   ▀▀▀
//                                                               █      ▄▄▄█▄▄▄    █   █
//                                                               ▀      █  █  █     █▄█
//                                                             ▀▀▀▀▀    █  █  █      ▀
//                                                                      ▀  ▀  ▀
//
// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄
//
//   Layer 0: BASE    — QWERTY, dedicated thumb modifiers, outer pinky keys
//   Layer 1: SYMFN   — symbols, brackets, F1-F12 (hold Left Thumb 2)
//   Layer 2: NAVNUM  — navigation arrows, keypad numbers (hold Right Thumb 2)
//   Layer 3: MEDIA   — media, brightness, app launchers, BT profiles (dual-thumb combo 32+35)
//   Layer 4: MOUSE   — mouse movement, scroll, clicks (dual-thumb combo 33+34)

#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE   0
#define SYMFN  1
#define NAVNUM 2
#define MEDIA  3
#define MOUSE  4

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <200>;
    quick-tap-ms = <175>;
    require-prior-idle-ms = <150>;
};

&lt {
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = <175>;
};

/ {
    combos {
        compatible = "zmk,combos";

        // ── Tier 1: Essential ──────────────────────────────────────

        combo_caps_word {
            bindings = <&caps_word>;
            key-positions = <10 11>;         // F + J (index home row)
            timeout-ms = <30>;
            require-prior-idle-ms = <150>;
        };

        // ── Tier 2: High Value ─────────────────────────────────────

        combo_enter {
            bindings = <&kp RET>;
            key-positions = <17 18 16>;         // K + L
            timeout-ms = <30>;
            require-prior-idle-ms = <150>;
        };

        combo_copy {
            bindings = <&kp LG(C)>;
            key-positions = <20 22>;         // X + C
            timeout-ms = <30>;
            require-prior-idle-ms = <150>;
        };

        combo_paste {
            bindings = <&kp LG(V)>;
            key-positions = <20 23>;         // C + V
            timeout-ms = <30>;
            require-prior-idle-ms = <150>;
        };

        combo_cut {
            bindings = <&kp LG(X)>;
            key-positions = <21 20>;         // X + V (skip middle)
            timeout-ms = <30>;
            require-prior-idle-ms = <150>;
        };

        // ── Tier 3: Vertical Symbol Combos ─────────────────────────

        combo_equal {
            bindings = <&kp EQUAL>;
            key-positions = <7 8>;         // F + V (left index vertical)
            timeout-ms = <40>;
            require-prior-idle-ms = <100>;
        };

        media_layer {
            bindings = <&lt MEDIA RIGHT_ALT>;
            key-positions = <32 35>;
        };

        tilde {
            bindings = <&kp TILDE>;
            key-positions = <16 25>;
        };

        Tab {
            bindings = <&kp TAB>;
            key-positions = <0 1>;
        };

        minus_and_underscore {
            bindings = <&kp MINUS>;
            key-positions = <19 18>;
        };

        plus {
            bindings = <&kp PLUS>;
            key-positions = <8 9>;
        };

        quick_search {
            bindings = <&kp C_AC_SEARCH>;
            key-positions = <11 12 13>;
        };

        mouse_layer {
            bindings = <&lt MOUSE LEFT_ALT>;
            key-positions = <33 34>;
        };
    };

    macros {
        hyper: hyper {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LGUI &kp LALT &kp LCTRL &kp LSHFT>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LGUI &kp LALT &kp LCTRL &kp LSHFT>;
        };

        degree: degree {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LA(NUMBER_8))>;
            label = "DEGREE";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

        base_layer {
            display-name = "BASE";
            bindings = <
&kp Q          &kp W  &kp E                       &kp R          &kp T           &kp Y      &kp U      &kp I                 &kp O    &kp P
&kp A          &kp S  &kp D                       &kp F          &kp G           &kp H      &kp J      &kp K                 &kp L    &kp SEMI
&kp Z          &kp X  &kp C                       &kp V          &kp B           &kp N      &kp M      &kp COMMA             &kp DOT  &kp SLASH
&mt RCTRL ESC         &mt LEFT_COMMAND BACKSPACE  &lt SYMFN TAB  &kp LEFT_SHIFT  &kp SPACE  &lt NAVNUM TAB  &mt RIGHT_ALT DELETE           &kp SINGLE_QUOTE
            >;
        };

        symfn_layer {
            bindings = <
&kp PIPE          &kp AT            &kp HASH              &kp DOLLAR      &kp PERCENT       &kp CARET          &kp AMPERSAND    &kp ASTERISK           &kp BACKSPACE  &kp DELETE
&kp LA(NUMBER_1)  &kp RA(QUESTION)  &kp LEFT_PARENTHESIS  &kp LEFT_BRACE  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp RIGHT_BRACE  &kp RIGHT_PARENTHESIS  &kp QUESTION   &kp EXCLAMATION
&kp F2            &kp F3            &kp F4                &kp F5          &kp F6            &kp F7             &kp F8           &kp F9                 &kp F10        &kp F11
&kp F1                              &none                 &none           &none             &kp SPACE          &kp RIGHT_ALT    &kp RIGHT_COMMAND                     &kp F12
            >;

            label = "SYMFN";
        };

        navnum_layer {
            display-name = "NAVNUM";
            bindings = <
&kp TAB                  &kp HOME       &kp UP        &kp END       &kp K_REDO      &kp DOT          &kp KP_N7        &kp KP_N8  &kp KP_N9  &kp KP_PLUS
&kp CAPSLOCK             &kp LEFT       &kp DOWN      &kp RIGHT     &kp K_UNDO      &kp COMMA        &kp KP_N4        &kp KP_N5  &kp KP_N6  &kp KP_MINUS
&kp INS                  &kp PAGE_DOWN  &kp RG(DOWN)  &kp PG_UP     &kp ENTER       &kp KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_N2  &kp KP_N3  &kp KP_MULTIPLY
&mt LEFT_CONTROL ESCAPE                 &kp LEFT_ALT  &kp LEFT_GUI  &sk LEFT_SHIFT  &none            &none            &none                 &hyper
            >;
        };

        media_layer {
            display-name = "MEDIA";
            bindings = <
&none                 &kp C_AL_INSTANT_MESSAGING  &kp C_AL_CALC         &kp C_AL_CALENDAR     &none  &kp C_STOP    &kp C_PREV    &kp C_PLAY_PAUSE   &kp C_NEXT       &none
&kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC        &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &none  &none         &kp C_MUTE    &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &none
&none                 &none                       &none                 &none                 &none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2       &bt BT_SEL 3     &none
&mt RCTRL ESCAPE                                  &none                 &none                 &none  &none         &none         &none                               &bt BT_CLR
            >;
        };

        mouse_layer {
            display-name = "MOUSE";
            bindings = <
&none              &msc SCRL_LEFT  &mmv MOVE_UP    &msc SCRL_RIGHT  &none             &none  &none      &mmv MOVE_Y(300)   &none      &none
&mmv MOVE_X(-300)  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &mmv MOVE_X(300)  &none  &mkp LCLK  &mmv MOVE_Y(-300)  &mkp RCLK  &none
&none              &msc SCRL_DOWN  &none           &msc SCRL_UP     &none             &none  &none      &mkp MCLK          &none      &none
&none                              &none           &none            &none             &none  &none      &none                         &none
            >;
        };
    };
};
