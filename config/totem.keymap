//                                                         ▀▀▀   █   ▀▀▀   █   ▀▀▀   ▀   ▀▀▀
//                                                               █      ▄▄▄█▄▄▄    █   █
//                                                               ▀      █  █  █     █▄█
//                                                             ▀▀▀▀▀    █  █  █      ▀
//                                                                      ▀  ▀  ▀
//
// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄
//
//   Miryoku-style layout — QWERTY base, vim arrows (HJKL), GACS home row mods
//
//   Layer 0: BASE    — QWERTY + home row mods
//   Layer 1: NAV     — vim arrows, clipboard, nav (hold SPACE)
//   Layer 2: NUM     — numpad left hand (hold BSPC)
//   Layer 3: MEDIA   — media, BT (hold ESC)
//   Layer 4: SYM     — symbols left hand (hold ENTER)
//   Layer 5: FUN     — function keys left hand (hold DEL)
//   Layer 6: MOUSE   — mouse movement, scroll, buttons (hold TAB)

#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE  0
#define NAV   1
#define NUM   2
#define MEDIA 3
#define SYM   4
#define FUN   5
#define MOUSE 6

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <200>;
    quick-tap-ms = <175>;
    require-prior-idle-ms = <150>;
};

&lt {
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = <175>;
};

/ {
    combos {
        compatible = "zmk,combos";

        // ── Tier 1: Essential ──────────────────────────────────────

        combo_caps_word {
            bindings = <&caps_word>;
            key-positions = <10 11>;         // F + J (index home row)
            timeout-ms = <30>;
            require-prior-idle-ms = <150>;
        };

        // ── Tier 2: High Value ─────────────────────────────────────

        combo_enter {
            bindings = <&kp RET>;
            key-positions = <17 18 16>;         // K + L
            timeout-ms = <30>;
            require-prior-idle-ms = <150>;
        };

        combo_copy {
            bindings = <&kp LG(C)>;
            key-positions = <20 22>;         // X + C
            timeout-ms = <30>;
            require-prior-idle-ms = <150>;
        };

        combo_paste {
            bindings = <&kp LG(V)>;
            key-positions = <20 23>;         // C + V
            timeout-ms = <30>;
            require-prior-idle-ms = <150>;
        };

        combo_cut {
            bindings = <&kp LG(X)>;
            key-positions = <21 20>;         // X + V (skip middle)
            timeout-ms = <30>;
            require-prior-idle-ms = <150>;
        };

        // ── Tier 3: Vertical Symbol Combos ─────────────────────────

        combo_equal {
            bindings = <&kp EQUAL>;
            key-positions = <7 8>;         // F + V (left index vertical)
            timeout-ms = <40>;
            require-prior-idle-ms = <100>;
        };

        media_layer {
            bindings = <&lt 3 RCTRL>;
            key-positions = <32 35>;
        };

        tilde {
            bindings = <&kp TILDE>;
            key-positions = <16 25>;
        };

        Tab {
            bindings = <&kp TAB>;
            key-positions = <0 1>;
        };

        minus_and_underscore {
            bindings = <&kp MINUS>;
            key-positions = <19 18>;
        };

        plus {
            bindings = <&kp PLUS>;
            key-positions = <8 9>;
        };
    };

    macros {
        hyper: hyper {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LGUI &kp LALT &kp LCTRL &kp LSHFT>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LGUI &kp LALT &kp LCTRL &kp LSHFT>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

        base_layer {
            display-name = "BASE";
            bindings = <
&kp Q          &kp W  &kp E                   &kp R      &kp T           &kp Y      &kp U      &kp I                     &kp O    &kp P
&kp A          &kp S  &kp D                   &kp F      &kp G           &kp H      &kp J      &kp K                     &kp L    &kp SEMI
&kp Z          &kp X  &kp C                   &kp V      &kp B           &kp N      &kp M      &kp COMMA                 &kp DOT  &kp SLASH
&mt RCTRL ESC         &mt LEFT_ALT BACKSPACE  &lt 1 TAB  &kp LEFT_SHIFT  &kp SPACE  &lt 2 TAB  &mt RIGHT_COMMAND DELETE           &kp SINGLE_QUOTE
            >;
        };

        navnum_layer {
            display-name = "NAVNUM";
            bindings = <
&kp CARET  &kp HOME       &kp UP        &kp END    &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp KP_N7        &kp KP_N8     &kp KP_N9  &kp PLUS
&kp TILDE  &kp LEFT       &kp DOWN      &kp RIGHT  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp KP_N4        &kp KP_N5     &kp KP_N6  &kp MINUS
&kp APOS   &kp PAGE_DOWN  &kp RG(DOWN)  &kp PG_UP  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp KP_NUMBER_1  &kp KP_N2     &kp KP_N3  &kp KP_MULTIPLY
&kp LCTRL                 &none         &none      &kp RET               &kp KP_N0              &kp KP_DOT       &kp KP_COMMA             &kp EQUAL
            >;
        };

        symfn_layer {
            bindings = <
&kp PIPE       &kp AT            &kp HASH          &kp DOLLAR  &kp PERCENT  &kp CARET          &kp AMPERSAND    &kp ASTERISK  &kp BACKSPACE    &kp F12
&kp RA(COLON)  &kp RA(NUMBER_1)  &kp RA(QUESTION)  &none       &kp C_PP     &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp QUESTION  &kp EXCLAMATION  &kp F11
&kp F1         &kp F2            &kp F3            &kp F4      &kp F5       &kp F6             &kp F7           &kp F8        &kp F9           &kp F10
&none                            &none             &none       &none        &none              &none            &none                          &kp ENTER
            >;

            label = "SYMFN";
        };

        media_layer {
            display-name = "MEDIA";
            bindings = <
&none     &none     &none      &none      &none         &kp C_PP      &none         &none         &none       &none
&kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &none         &kp C_PREV    &kp C_VOL_DN  &kp C_VOL_UP  &kp C_NEXT  &none
&none     &none     &none      &none      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_CLR  &mt LCTRL ESC
&none               &none      &none      &none         &none         &none         &none                     &kp K_MUTE
            >;
        };

        mouse_layer {
            display-name = "MOUSE";
            bindings = <
&none              &msc SCRL_LEFT  &mmv MOVE_UP    &msc SCRL_RIGHT  &none             &none      &none      &mmv MOVE_Y(300)   &none      &none
&mmv MOVE_X(-300)  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &mmv MOVE_X(300)  &none      &mkp LCLK  &mmv MOVE_Y(-300)  &mkp RCLK  &none
&none              &msc SCRL_DOWN  &none           &msc SCRL_UP     &none             &none      &none      &none              &none      &none
&none                              &none           &none            &none             &mkp MCLK  &none      &hyper                        &none
            >;
        };
    };
};
